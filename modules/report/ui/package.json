{
  "name": "@addzero/report-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm clean && pnpm generate:api && vite build && tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "pnpm generate:api && vite dev",
    "generate:api": "pnpm generate:contract && orval --config orval.config.ts",
    "generate:contract": "../../../../kotlin run --project-dir=../../../.. --build-dir=../../../build/report-client-contract -m client-contract -- ../../development-host/src/main/resources/site/addzero/studio/development/openapi.json",
    "test": "pnpm generate:api && vitest run",
    "typecheck": "pnpm generate:api && tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/react": "0.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@platform/ui": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-table": "9.2.4",
    "echarts": "6.1.0",
    "lucide-react": "^0.542.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.4.0",
    "orval": "8.27.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "vitest": "4.1.0"
  }
}
